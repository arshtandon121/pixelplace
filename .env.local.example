# Database
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.uifthci.mongodb.net/pixelplace?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App
NEXT_PUBLIC_APP_URL=https://www.pixelplace.in
NEXT_PUBLIC_PIXEL_PRICE_PER_MONTH=10
# Dodo PWYW minimum. Hour/day listings under this are charged this amount.
NEXT_PUBLIC_MIN_CHECKOUT_INR=60
ADMIN_PASSWORD=change-this-admin-password

# Dodo Payments — https://docs.dodopayments.com/developer-resources/integration-guide
DODO_API_KEY=your-dodo-api-key
DODO_ENVIRONMENT=live_mode
DODO_PRODUCT_ID=pdt_...
DODO_WEBHOOK_SECRET=whsec_...
# Webhook URL in Dodo dashboard: https://www.pixelplace.in/api/webhook/dodo

# Email notifications on every successful payment
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PixelPlace <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=you@example.com
