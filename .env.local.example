# Database
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.uifthci.mongodb.net/pixelplace?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# App
NEXT_PUBLIC_APP_URL=https://www.pixelplace.in
NEXT_PUBLIC_PIXEL_PRICE_PER_MONTH=10
ADMIN_PASSWORD=change-this-admin-password

# Polar payments — https://polar.sh/docs/introduction
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=polar_oat_...
SANDBOX_POLAR_TOKEN=polar_oat_...
POLAR_PRODUCT_ID=prod_...
POLAR_SANDBOX_PRODUCT_ID=prod_...
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_SANDBOX_WEBHOOK_SECRET=whsec_...

# Email notifications on every successful payment
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PixelPlace <onboarding@resend.dev>
ADMIN_NOTIFY_EMAIL=you@example.com
